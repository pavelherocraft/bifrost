upstream litellm_upstream {
    server 127.0.0.1:4001;
    keepalive 16;
}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    listen 8080;
    listen [::]:8080;
    server_name hcbifrost.herocraft.com;
    # Block China IP ranges (8801 CIDRs from ipdeny.com)
    if ($is_cn = yes) {
        return 403;
    }

    client_max_body_size 100M;
    absolute_redirect off;

    # ---- opencode-setup generator (static + api) ----
    location ^~ /setup-opencode {
        alias /opt/opencode-setup/;
        index index.html;
        try_files $uri $uri/ /index.html =404;
    }
    location ^~ /setup-opencode/api/ {
        proxy_pass http://127.0.0.1:9000/;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_read_timeout 10s;
        access_log off;
    }

    location = / {
        return 302 /litellm/ui/;
    }

    # ---- LiteLLM UI SPA at /ui/ (without /litellm/ prefix) ----
    # LiteLLM Next.js UI generates invite URLs as ${origin}/ui/?invitation_id=<id>
    # and shares them with new users. Without this rule, nginx returns 404 for /ui/*
    # because the /litellm/ catch-all doesn't match.
    # /litellm/ prefix in proxy_pass is REQUIRED: LiteLLM FastAPI serves UI under
    # SERVER_ROOT_PATH=/litellm, so /ui/ returns 404 but /litellm/ui/ returns 200.
    location ^~ /ui/ {
        proxy_pass http://litellm_upstream/litellm/ui/;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        sub_filter '</head>' '<script src="/setup-opencode/users-btn.js?v=16"></script><script src="/setup-opencode/vkeys-btn.js?v=7"></script><script src="/setup-opencode/glm-swap-btn.js?v=1"></script></head>';
        sub_filter_once off;
    }

    # ---- LiteLLM invite/onboarding routes (no /litellm/ prefix) ----
    # The Next.js UI generates invite URLs as `${origin}/onboarding?invite_link=<id>`
    # and calls `/invitation/*` + `/onboarding/*` relatively. Without these
    # rules nginx returns 404 because the /litellm/ catch-all doesn't match.
    location = /onboarding {
        # SPA page - proxy to LiteLLM's /litellm/ui/onboarding/ route (Next.js renders there).
        # CRITICAL: path MUST include /litellm/ prefix because LiteLLM serves the UI
        # under SERVER_ROOT_PATH=/litellm. /ui/onboarding/ returns 404; /litellm/ui/onboarding/ returns 200.
        # (Same reason why /litellm/ catch-all above works via @litellm_ui fallback that re-sends the full path.)
        # Trailing slash REQUIRED: without it LiteLLM returns 307 redirect to add the slash,
        # which drops query params (including ?invite_link=...).
        proxy_pass http://litellm_upstream/litellm/ui/onboarding/$is_args$args;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        sub_filter '</head>' '<script src="/setup-opencode/users-btn.js?v=16"></script><script src="/setup-opencode/vkeys-btn.js?v=7"></script><script src="/setup-opencode/glm-swap-btn.js?v=1"></script></head>';
        sub_filter_once off;
    }
    location ~ ^/(invitation|onboarding)/ {
        # API endpoints: /invitation/{new,info,update} + /onboarding/{get_token,claim_token}
        proxy_pass http://litellm_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
    }

