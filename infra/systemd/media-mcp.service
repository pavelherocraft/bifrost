[Unit]
Description=media-mcp — FastMCP media generation server (behind LiteLLM MCP gateway)
After=network.target

[Service]
Type=simple
User=dev01
WorkingDirectory=/opt/media-mcp
ExecStart=/opt/media-mcp/venv/bin/python /opt/media-mcp/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
